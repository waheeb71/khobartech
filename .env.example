# Set after purchasing and connecting the production domain.
NEXT_PUBLIC_SITE_URL=

# Comma-separated email allowlist for the first CMS administrators.
ADMIN_EMAILS=owner@example.com

# Optional Google Analytics measurement ID.
NEXT_PUBLIC_GA_ID=

# Provided by Manus in managed runtime; do not set literal values in source control.
# DATABASE_URL=
# MANUS_JWT_SECRET=
# MANUS_API_URL=
# MANUS_API_KEY=
# MANUS_PROJECT_ID=
# MANUS_OAUTH_PORTAL_URL=
# MANUS_OAUTH_API_URL=

# Optional public contact values; editable from CMS after setup.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
